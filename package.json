{
    "name": "@protontech/telemetry",
    "version": "2.1.0",
    "description": "Frontend telemetry library for Proton websites",
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "LICENSE",
        "README.md"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ProtonMail/proton-telemetry.git"
    },
    "license": "GPL-3.0-or-later",
    "scripts": {
        "build": "tsc",
        "test": "vitest run",
        "test:cover": "vitest run --coverage",
        "lint": "eslint . --quiet",
        "release:prepare": "pnpm run lint && pnpm run test && pnpm run build",
        "version:patch": "npm version patch",
        "version:minor": "npm version minor",
        "version:major": "npm version major",
        "publish:prepare": "npm run build && git add dist -f",
        "push:tags": "git push --follow-tags"
    },
    "publishConfig": {
        "access": "public"
    },
    "devDependencies": {
        "@types/node": "^22.15.21",
        "@typescript-eslint/eslint-plugin": "^8.60.1",
        "@typescript-eslint/parser": "^8.60.1",
        "@vitest/coverage-v8": "^4.0.0",
        "eslint": "10.9.1",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-prettier": "5.5.6",
        "happy-dom": "20.12.0",
        "prettier": "3.9.6",
        "typescript": "6.0.3",
        "vite": "8.2.2",
        "vitest": "4.1.11"
    },
    "packageManager": "pnpm@11.25.0+sha512.5cde925b4f075f725eb71fbae18a42ffe784524789f19b61c731cb8721ec28aaee160e01a8d5af4fedb2a42cdbf300efe23db356b0d4a17b4d63e11f8ab7c956"
}
